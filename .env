# Copy this file to ".env" and fill in your real values. Never commit ".env".

SECRET_KEY=some-long-random-string
DATABASE_URL=sqlite:///event.db

# ---- Email (SMTP) settings ----
# Example below is for Gmail. You must use a 16-character "App Password",
# not your normal Gmail password. Generate one at:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=rajaprabhu75@gmail.com
MAIL_PASSWORD=hwvvbunzfefoyser
MAIL_DEFAULT_SENDER=rajaprabhu75@gmail.com

# ---- Organizer admin panel ----
# Password organizers use to log in at /admin to view all registration data.
# CHANGE THIS before the real event.
ADMIN_PASSWORD=change-this-password

# ---- Event details ----
EVENT_NAME=Annual Tech Fest 2026
EVENT_DATE=August 15, 2026
EVENT_VENUE=Main Auditorium

# ---- Base URL ----
# This is embedded inside every QR code as https://<BASE_URL>/scan/<code>.
# For local testing this can stay as-is. For the real event, this MUST be a
# URL reachable by the organizers' phones (e.g. a deployed server URL, or an
# ngrok tunnel URL like https://abcd1234.ngrok-free.app).
BASE_URL=http://127.0.0.1:5000
